{
  "name": "stage-presence-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {"node": ">=22.12"},
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b --pretty false",
    "eval:capture": "node --experimental-strip-types --test scripts/captureIntelligence.test.mjs",
    "test:backend-contracts": "node --test scripts/backendContracts.test.mjs scripts/pricingRuntime.contract.test.mjs scripts/commercialOperationsBridge.contract.test.mjs scripts/resourceRequirementRuntime.contract.test.mjs scripts/warehouseFulfillmentRuntime.contract.test.mjs scripts/actualsRuntime.contract.test.mjs scripts/jobWorkspace.contract.test.mjs scripts/operationsCommandSurface.contract.test.mjs scripts/inventoryCapacityRuntime.contract.test.mjs scripts/warehouseVerificationSurface.contract.test.mjs scripts/maintenanceServiceRuntime.contract.test.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.115.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "wrangler": "4.129.1"
  }
}
